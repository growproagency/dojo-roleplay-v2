# Copy this to .env.local and fill in your values
# .env.local is gitignored — never commit real values

# Your Supabase project URL and anon key (safe for frontend — RLS protects data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Your backend API URL
# In development this is proxied by Vite — leave blank or use full URL
VITE_API_URL=http://localhost:3001

# Loom walkthrough shown in the Scenario Builder "How to guide"
# Paste the Loom share link — the app converts it to the embed URL
# Leave blank to hide the video and show the written steps only
VITE_SCENARIO_BUILDER_LOOM_URL=https://www.loom.com/share/your-loom-id
